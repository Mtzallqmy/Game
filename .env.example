# NAGEEL development-only configuration. Never commit real credentials.
# Copy to .env and replace DATABASE_URL with a real development-branch connection URL.
NEON_PROJECT_ID=dry-surf-72406677
NEON_BRANCH=development
NEON_BRANCH_ID=br-orange-pond-badvwqgc
NEON_DATABASE=nageel_db
DATABASE_URL=postgresql://USER:PASSWORD@DEVELOPMENT_ENDPOINT/nageel_db?sslmode=require
PORT=3000

# Managed Neon Auth on the development branch. Never send Neon MCP tokens to the game.
NEON_AUTH_ISSUER=https://ep-odd-forest-ba7sm41n.neonauth.c-8.eu-central-1.aws.neon.tech/nageel_db/auth
NEON_AUTH_JWKS_URL=https://ep-odd-forest-ba7sm41n.neonauth.c-8.eu-central-1.aws.neon.tech/nageel_db/auth/.well-known/jwks.json
# Optional if your JWTs have the expected audience:
NEON_AUTH_AUDIENCE=

# Browser origins allowed to call the API, separated by commas. Native Unity clients send no Origin.
NAGEEL_ALLOWED_ORIGINS=
# Redirect download links only to explicitly approved hosts.
NAGEEL_CDN_HOSTS=br-orange-pond-badvwqgc.storage.c-8.eu-central-1.aws.neon.tech

# No package is published until a real Unity bundle is uploaded, SHA-256 verified,
# and asset_manifests.ready_for_download is explicitly set to TRUE.
